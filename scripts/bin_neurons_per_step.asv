% script to extract all cells, align by steps (location changes),
% and bin into 400 bins per repeat with reward-step alignment

clear all
do_plot = true;

source_dir = "/Users/xpsy1114/Documents/projects/multiple_clocks/data/ephys_humans"
if ~exist(source_dir, 'dir')
    source_dir = '/ceph/behrens/svenja/human_ABCD_ephys'
    abcd_data = load(sprintf("%s/beh_cells/abcd_data_08-Sep-2025.mat", source_dir));
else
    abcd_data = load(sprintf("%s/derivatives/abcd_passed.mat", source_dir));
end

deriv_dir = sprintf("%s/derivatives/", source_dir);

subject_list = 1:length(abcd_data.abcd_passed.abcd_data);

% PARAMETERS
n_bins_total = 400;
reward_bins = [100 200 300 400];

% LOOP THROUGH SUBJECTS
for sub = 59
    subj = abcd_data.abcd_passed.abcd_data(sub);
    subject_folder = sprintf("%ss%02d/cells_and_beh", deriv_dir, sub);
    if ~exist(subject_folder, 'dir')
        mkdir(subject_folder);
    end

    for cell_idx = 1:length(subj.neural_data)

        curr_cell_label = subj.neural_data(cell_idx).electrodeLabel;
        if isempty(subj.neural_data(cell_idx).roi) || isempty(subj.neural_data(cell_idx).roi{1})
            curr_roi_label = subj.neural_data(cell_idx).regionLabel;
        else
            curr_roi_label = subj.neural_data(cell_idx).roi{1};
        end

        combo_cell_label = sprintf('%02d-%s-%s', cell_idx, curr_cell_label, curr_roi_label);
        curr_spike_times = subj.neural_data(cell_idx).spikeTimes;

        all_reps_curr_cell = [];

        if cell_idx == 1
            locations_all_reps = [];
        end

        % LOOP TRIALS
        for t = 1:length(subj.trial_vars)

            spike_rates_row = nan(1, n_bins_total);
            location_bins_row = nan(1, n_bins_total);

            trial = subj.trial_vars(t);

            locs = trial.start_location;
            loc_times = trial.grid_onset_timestamp;
            buttons = trial.button_pressed;

            if isempty(locs) || isempty(loc_times)
                all_reps_curr_cell = [all_reps_curr_cell; spike_rates_row];
                continue
            end

            % === STEP DETECTION (location changes) ===
            step_idx = [find(diff(locs') ~= 0)];
            step_times = loc_times(step_idx);
            step_locs = locs(step_idx);
            step_button = buttons(step_idx);

            % add trial end
            step_times = [step_times; trial.end_trial_timestamp];
            step_

            n_steps = length(step_locs);

            % === FIND REWARD STEPS ===
            reward_times = trial.state_change_times;
            goal_locs = trial.sequence_locations;
    
            reward_step_idx = nan(1, length(reward_times));

            for r = 1:length(reward_times)
                [~, idx] = min(abs(step_times - reward_times(r)));
                reward_step_idx(r) = idx;
            end

            % sanity check (optional)
            % compare with goal locations
            % step_locs(reward_step_idx) vs goal_locs

            % === BUILD STEP SEGMENTS BETWEEN REWARDS ===
            all_bin_edges = [];

            for seg = 1:4

                if seg == 1
                    start_step = 1;
                else
                    start_step = reward_step_idx(seg-1);
                end

                end_step = reward_step_idx(seg);

                steps_in_seg = start_step:end_step;
                n_seg_steps = length(steps_in_seg);

                bins_per_seg = 100;

                % divide evenly
                bins_per_step = floor(bins_per_seg / n_seg_steps);
                remainder = mod(bins_per_seg, n_seg_steps);

                bin_edges_seg = [];

                for s = 1:n_seg_steps
                    step_i = steps_in_seg(s);

                    t_start = step_times(step_i);
                    t_end = step_times(step_i+1);

                    curr_bins = bins_per_step;
                    if s <= remainder
                        curr_bins = curr_bins + 1;
                    end

                    edges = linspace(t_start, t_end, curr_bins+1);

                    if isempty(bin_edges_seg)
                        bin_edges_seg = edges;
                    else
                        bin_edges_seg = [bin_edges_seg edges(2:end)];
                    end
                end

                if isempty(all_bin_edges)
                    all_bin_edges = bin_edges_seg;
                else
                    all_bin_edges = [all_bin_edges bin_edges_seg(2:end)];
                end
            end

            % safety check
            if numel(all_bin_edges) ~= n_bins_total+1
                warning('Bin mismatch, skipping trial');
                all_reps_curr_cell = [all_reps_curr_cell; spike_rates_row];
                continue
            end

            % === SPIKE BINNING ===
            spike_counts = histcounts(curr_spike_times, all_bin_edges);
            bin_durations = diff(all_bin_edges);

            spike_rates = spike_counts ./ bin_durations;

            spike_rates_row = spike_rates;

            % === LOCATION BINNING ===
            if cell_idx == 1
                bin_centers = (all_bin_edges(1:end-1) + all_bin_edges(2:end)) / 2;

                for b = 1:n_bins_total
                    idx = find(loc_times <= bin_centers(b), 1, 'last');
                    location_bins_row(b) = locs(idx);
                end
            end

            all_reps_curr_cell = [all_reps_curr_cell; spike_rates_row];

            if cell_idx == 1
                locations_all_reps = [locations_all_reps; location_bins_row];
            end

        end

        % % === SAVE ===
        % if ~isempty(all_reps_curr_cell)
        %     csvwrite(fullfile(subject_folder, sprintf('cell-%02d-%s-400_bins_steps.csv', cell_idx, combo_cell_label)), all_reps_curr_cell);
        % 
        %     if cell_idx == 1
        %         csvwrite(fullfile(subject_folder, 'locations_steps_400.csv'), locations_all_reps);
        %     end
        % end

        % === OPTIONAL PLOT ===
        if do_plot && ~isempty(all_reps_curr_cell)
            mean_firing = mean(all_reps_curr_cell, 1);
            subplot(ceil(sqrt(length(subj.neural_data))), [], cell_idx);
            plot(mean_firing, 'k', 'LineWidth', 1.5)
            title(sprintf('Cell %d', cell_idx));
            xlabel('Bin (1–400)');
            ylabel('Firing rate');
        end

    end
end

disp('DONE!');